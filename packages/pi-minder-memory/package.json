{
  "name": "pi-minder-memory",
  "version": "0.1.1",
  "description": "Auditable Markdown memory and full-text search",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "pi-package",
    "minder",
    "memory"
  ],
  "pi": {
    "extensions": [
      "./lib/index.js"
    ]
  },
  "peerDependencies": {
    "typebox": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typebox": "1.3.27",
    "@earendil-works/pi-coding-agent": "1.6.0"
  },
  "dependencies": {
    "@minder/core-memory": "workspace:^"
  }
}
